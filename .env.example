# Server-side only (Vercel env vars, never exposed to the browser)
MORPHIC_API_URL=
MORPHIC_API_KEY=
CLOUDFLARE_TURNSTILE_SECRET=

# Client-side (public, prefixed with VITE_ — used by the Turnstile widget)
VITE_TURNSTILE_SITE_KEY=
# Neon Auth client URL (safe to expose to the browser)
VITE_NEON_AUTH_URL=

# Optional server-only override for the Neon Auth base URL. When omitted,
# the server uses VITE_NEON_AUTH_URL for JWT verification.
NEON_AUTH_BASE_URL=

# Optional exact Neon Auth JWKS URL. Defaults to
# <NEON_AUTH_BASE_URL>/.well-known/jwks.json.
NEON_AUTH_JWKS_URL=

# Pooled Neon Postgres connection string (server-side only)
DATABASE_URL=

# Optional comma-separated Neon Auth user IDs that can export without spending credits.
# Use exact public.user_profiles.user_id values. Server-side only.
UNLIMITED_USER_IDS=

# Polar sandbox checkout and signed webhooks (server-side only)
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_STARTER=
POLAR_PRODUCT_POPULAR=
POLAR_PRODUCT_PRO=
POLAR_WEBHOOK_SECRET=

# Public application origin used for checkout return/success URLs. HTTPS is
# required outside localhost, for example https://shotage.com.
APP_URL=
