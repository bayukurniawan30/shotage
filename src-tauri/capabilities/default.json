{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Shotage desktop main window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-stat",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:deny-default",
    "opener:default",
    "deep-link:default",
    "window-state:default",
    "store:default",
    "updater:default",
    "process:allow-restart"
  ]
}
